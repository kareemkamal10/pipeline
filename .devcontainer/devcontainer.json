{
  "name": "History Lab Pipeline",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },

  "onCreateCommand": "bash .devcontainer/install.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.defaultLanguage": "yaml"
      }
    }
  },

  "postCreateCommand": "echo '✔ البيئة جاهزة — عدّل config.yaml وplayLinks.csv ثم شغّل: bash vertex/setup.sh'",

  "remoteEnv": {
    "GOOGLE_APPLICATION_CREDENTIALS": "/workspaces/pipeline/secrets/CREDENTIALS.json"
  }
}
